{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft": "Information"
    }
  },
  "AllowedHosts": "*",
  "ServiceConfig": {
    "serviceDiscoveryAddress": "http://localhost:8500",
    "serviceName": "gaj-router",
    "serviceId": "3",
    "serviceAddress": "http://gaj-router:80"
  },
  "GajImgsApiConfiguration": {
    //"BaseUrl": "http://gaj-imgs",
    "BaseUrl": "http://localhost:43010",
    "Endpoints": {
      "Images": "api/v1/Images"
    }
  },
  "GajUsersApiConfiguration": {
    //"BaseUrl": "http://gaj-ids4",
    "BaseUrl": "http://localhost:5000",
    "Endpoints": {
      "Users": "api/v1/Users",
      "Auth": "api/v1/Auth"
    }
  },
  "GajStoreApiConfiguration": {
    //"BaseUrl": "http://gaj-store",
    "BaseUrl": "http://localhost:43030",
    "Endpoints": {
      "Games": "api/v1/Games",
      "Studios": "api/v1/Studios"
    }
  }
}
